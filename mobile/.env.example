# Mobile API base URL (no trailing slash).
#
# Production / EAS builds (recommended default):
EXPO_PUBLIC_API_URL=https://apna-reading-hub.vercel.app
#
# Local backend on a physical phone (same Wi-Fi as your computer):
# EXPO_PUBLIC_API_URL=http://192.168.x.x:4001
#
# Android emulator → host machine:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:4001
#
# iOS simulator:
# EXPO_PUBLIC_API_URL=http://localhost:4001
