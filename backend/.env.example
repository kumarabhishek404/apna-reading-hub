# Copy to backend/.env for local development (never commit real secrets).

# --- Required in production (Vercel / Render) ---
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/reading-hub?retryWrites=true&w=majority
# JWT_SECRET=<long-random-string>   # must NOT be "change-me-to-a-long-random-string"
# FRONTEND_URL=https://your-frontend.example.com

# --- Local development defaults ---
# MONGODB_URI=mongodb://localhost:27017/reading-hub
MONGODB_URI=
JWT_SECRET=change-me-to-a-long-random-string
PORT=4001
# FRONTEND_URL=http://localhost:3000
UPLOADS_DIR=./uploads

# MongoDB Atlas setup checklist:
# 1) Create a DB user in Atlas → Database Access
# 2) Network Access → Allow Access from Anywhere (0.0.0.0/0) for Vercel
# 3) Set MONGODB_URI + JWT_SECRET in Vercel Project → Settings → Environment Variables
# 4) Redeploy after setting env vars
# 5) Hit GET /api/health — expect { status: "ok", db: "connected" }
