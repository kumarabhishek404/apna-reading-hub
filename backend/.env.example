# Copy to backend/.env for local development (never commit real secrets).

# Local MongoDB
# MONGODB_URI=mongodb://localhost:27017/reading-hub

# MongoDB Atlas (production / Vercel)
# 1) Create a DB user in Atlas → Database Access
# 2) Network Access → Add IP Address → Allow Access from Anywhere (0.0.0.0/0)
#    Required for Vercel because serverless IPs change.
# 3) Paste your connection string here / in Vercel env vars:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/reading-hub?retryWrites=true&w=majority

MONGODB_URI=
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
FRONTEND_URL=http://localhost:3000
UPLOADS_DIR=./uploads
