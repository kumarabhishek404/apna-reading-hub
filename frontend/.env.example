# Local monorepo (separate Express on :4001)
NEXT_PUBLIC_API_URL=http://localhost:4001

# Vercel full-stack deploy: leave NEXT_PUBLIC_API_URL and INTERNAL_API_URL unset
# so the UI calls /api on the same origin (Express runs inside the Next.js app).
# Set DATABASE_URL (PostgreSQL) in the Vercel project environment instead.
