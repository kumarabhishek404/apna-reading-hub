{
  "name": "apna-reading-hub",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev -w @reading-hub/backend\" \"npx wait-on http://localhost:4001/health -t 30000 && npm run dev -w @reading-hub/frontend\"",
    "dev:backend": "npm run dev -w @reading-hub/backend",
    "dev:frontend": "npm run dev -w @reading-hub/frontend",
    "dev:mobile": "npm --prefix mobile run start",
    "mobile:start": "npm --prefix mobile run start",
    "mobile:android": "npm --prefix mobile run android",
    "mobile:ios": "npm --prefix mobile run ios",
    "mobile:typecheck": "npm --prefix mobile run typecheck",
    "db:up": "docker compose up -d",
    "db:setup": "docker compose up -d && npm run db:push -w @reading-hub/backend",
    "db:push": "npm run db:push -w @reading-hub/backend",
    "build": "npm run build -w @reading-hub/backend && npm run build -w @reading-hub/frontend",
    "vercel-build": "node scripts/prepare-vercel-db.js && next build --webpack",
    "start": "concurrently \"npm run start -w @reading-hub/backend\" \"npm run start -w @reading-hub/frontend\"",
    "db:migrate": "npm run db:migrate -w @reading-hub/backend",
    "db:studio": "npm run db:studio -w @reading-hub/backend",
    "lint": "npm run lint -w @reading-hub/frontend"
  },
  "dependencies": {
    "next": "16.2.9",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "wait-on": "^8.0.5"
  }
}
